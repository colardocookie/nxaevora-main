+/* the slow frames' samples, each next to the share the same function of the same thread has in all frames */
+static void write_slow(void) {
+    static ProfBucket sorted[PROF_BUCKETS];
+    char path[1200];
+    u64 image = (u64)(size_t)&__ImageBase;
+    FILE* f;
+    int i, n = 0;
+    snprintf(path, sizeof path, "%sprofile-slow.txt", g_exedir);
+    f = fopen(path, "w");
+    if (!f) return;
+    for (i = 0; i < PROF_BUCKETS; i++)
+        if (g_slow[i].key) sorted[n++] = g_slow[i];
+    qsort(sorted, (size_t)n, sizeof *sorted, bucket_cmp);
+    fprintf(f, "%llu of %llu frames took %d ms or more: %llu samples in them, %llu in all frames\n",
