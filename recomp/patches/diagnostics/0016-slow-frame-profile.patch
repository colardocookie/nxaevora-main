+static u32 count_of(const ProfBucket* table, u64 key) {
+    u32 i = (u32)((key >> 4) * 0x9E3779B1u) & (PROF_BUCKETS - 1), probe;
+    for (probe = 0; probe < 64; probe++, i = (i + 1) & (PROF_BUCKETS - 1)) {
+        if (table[i].key == key) return table[i].count;
+        if (!table[i].key) break;
+    }
+    return 0;
