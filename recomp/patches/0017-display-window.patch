+    int dir = arrow_direction();
+    int to = at >= 0 ? at + dir : dir > 0 ? below + 1 : below;
+    bool changed = false;
+    if (dir && to >= 0 && to < count) {
+        imgui_settings_preset(r.key, to, out, n, label, sizeof label);
+        changed = true;
+    }
+    if (!open) return changed;
+    for (int i = 0; i < count; ++i) {
