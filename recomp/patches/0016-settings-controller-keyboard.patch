+/* the buttons that text names */
+static u64 keybind_named(const char* text) {
+    u64 named = 0;
+    for (const char* at = text; *at;) {
+        size_t n = strcspn(at, " \t");
+        KeyEntry e;
+        if (!n) {
+            ++at;
+            continue;
+        }
+        if (key_entry_read(at, n, &e) == 0) named |= 1ull << e.bit;
+        at += n;
+    }
