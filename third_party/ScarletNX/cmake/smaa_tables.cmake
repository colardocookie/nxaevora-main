# snx_smaa_tables(target): the two lookup textures of SMAA (Jimenez et al., MIT, dist/smaa/LICENSE.txt)
# compiled into target. They are the DX9 area texture (160 x 560, two 8-bit channels) and the search texture
# (64 x 16, one channel) of the SMAA repository, each after the 128 bytes of its DDS header.
include_guard(GLOBAL)

function(snx_smaa_embed target file name offset)
    set(path "${PROJECT_SOURCE_DIR}/dist/smaa/${file}")
    set_property(DIRECTORY "${PROJECT_SOURCE_DIR}" APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${path}")
    file(READ "${path}" hex HEX OFFSET ${offset})
    string(LENGTH "${hex}" size)
    math(EXPR size "${size} / 2")
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){24})" "\\1\n    " bytes "${bytes}")
    # file(CONFIGURE) writes only when the content changed, so a configure rebuilds nothing on its own
    file(CONFIGURE OUTPUT "${PROJECT_BINARY_DIR}/generated/${name}.c" @ONLY CONTENT
"/* Generated by cmake/smaa_tables.cmake from ${file}. Do not edit. */
#include \"nx/gpu/vk/post_spv.h\"
const u8 ${name}[] = {
    @bytes@
};
const u64 ${name}_size = @size@;
")
    target_sources(${target} PRIVATE "${PROJECT_BINARY_DIR}/generated/${name}.c")
endfunction()

function(snx_smaa_tables target)
    snx_smaa_embed(${target} AreaTexDX9.dds smaa_area_tex 128)
    snx_smaa_embed(${target} SearchTex.dds smaa_search_tex 128)
endfunction()
