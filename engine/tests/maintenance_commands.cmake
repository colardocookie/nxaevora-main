# `logs export` and `cache clean` (runtime/maintenance_cli.c): one zip of a game's diagnostic files, and the deletion
# of its caches. The exit codes come from exit_codes.h. Run by ctest as runtime_maintenance_commands
set(dir "${CMAKE_CURRENT_BINARY_DIR}/maintenance-commands")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}")
set(env "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY SDL_VIDEO_DRIVER=dummy)
function(engine prefix)
    execute_process(COMMAND ${env} "${RUNTIME}" ${ARGN}
                    WORKING_DIRECTORY "${dir}" TIMEOUT 20 RESULT_VARIABLE code
                    OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set("${prefix}_code" "${code}" PARENT_SCOPE)
    set("${prefix}_out" "${out}" PARENT_SCOPE)
    set("${prefix}_err" "${err}" PARENT_SCOPE)
endfunction()

# ---- the fake home and data folder, as settings_commands.cmake: the game's program in recompiled/Fake/, its .ini in
# ---- the config folder, its log and threads.txt in the game's state folder, the early error file in the data folder's
# ---- state folder, its caches in the cache folder
set(root "${dir}/home")
if(WIN32)
    set(data "${root}/appdata/nxaevora")
    set(config "${data}/config")
    set(state "${data}/state")
    set(menu_cache "${data}/cache")
    set(ENV{APPDATA} "${root}/appdata")
else()
    set(data "${root}/data/nxaevora")
    set(config "${root}/config/nxaevora")
    set(state "${root}/state/nxaevora")
    set(menu_cache "${root}/cache/nxaevora")
    set(ENV{HOME} "${root}/home")
    set(ENV{XDG_DATA_HOME} "${root}/data")
    set(ENV{XDG_CONFIG_HOME} "${root}/config")
    set(ENV{XDG_STATE_HOME} "${root}/state")
    set(ENV{XDG_CACHE_HOME} "${root}/cache")
endif()
set(program "${data}/recompiled/Fake/Fake.exe")
set(game_state "${state}/recompiled/Fake")
set(game_config "${config}/recompiled/Fake")
set(game_cache "${menu_cache}/recompiled/Fake")
set(ini "${game_config}/Fake.ini")
set(log "${game_state}/Fake.log")
set(threads "${game_state}/threads.txt")
set(error_log "${state}/scarletnx-error.log")
set(old_log "${game_state}/logs/2026-01-01_00-00-00.log")
set(shaders "${game_cache}/shader_cache")
set(jitcache "${game_cache}/Fake.jitcache")
set(units "${menu_cache}/units")

file(MAKE_DIRECTORY "${data}/recompiled/Fake" "${state}" "${game_state}/logs" "${game_config}" "${game_cache}"
                    "${units}")
file(WRITE "${program}" "")
file(WRITE "${ini}" "[Graphics]\nrender_resolution=1\n")
file(WRITE "${log}" "the game log\n")
file(WRITE "${old_log}" "an older run\n")
file(WRITE "${threads}" "second 1, frames 2\n")
file(WRITE "${error_log}" "an early error\n")

set(existing "${dir}/existing.zip")
file(WRITE "${existing}" "keep me\n")
# ---- an existing --out and a game with no folders yet: exit 2 before any folder is made
set(fresh_program "${data}/recompiled/Fresh/Fresh.exe")
set(fresh_state "${state}/recompiled/Fresh")
set(fresh_config "${config}/recompiled/Fresh")
set(fresh_cache "${menu_cache}/recompiled/Fresh")
file(MAKE_DIRECTORY "${data}/recompiled/Fresh")
file(WRITE "${fresh_program}" "")
file(READ "${existing}" fresh_before_hex HEX)
engine(export_exists_fresh logs export "--game=${fresh_program}" "--out=${existing}")
file(READ "${existing}" fresh_after_hex HEX)
if(NOT export_exists_fresh_code EQUAL 2)
    message(FATAL_ERROR "logs export with a fresh game ended with ${export_exists_fresh_code}, not 2")
endif()
if(NOT fresh_before_hex STREQUAL fresh_after_hex)
    message(FATAL_ERROR "logs export to an existing --out changed the file")
endif()
if(EXISTS "${fresh_state}" OR EXISTS "${fresh_config}" OR EXISTS "${fresh_cache}")
    message(FATAL_ERROR "logs export to an existing --out made the game's folders")
endif()

# ---- an existing --out: exit 2, and the file's bytes stay
file(READ "${existing}" before_hex HEX)
engine(export_exists logs export "--game=${program}" "--out=${existing}")
file(READ "${existing}" after_hex HEX)
if(NOT export_exists_code EQUAL 2 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "logs export to an existing file ended with ${export_exists_code}, not 2, or changed it")
endif()

# ---- --out with no value (empty, empty word, last, or a word that starts with --): exit 2, and an error that names --out
engine(export_out_empty logs export "--game=${program}" "--out=")
engine(export_out_last logs export "--game=${program}" --out)
engine(export_out_option logs export "--game=${program}" --out "--game=${program}")
execute_process(COMMAND ${env} "${RUNTIME}" logs export "--game=${program}" --out ""
                WORKING_DIRECTORY "${dir}" TIMEOUT 20 RESULT_VARIABLE export_out_blank_code
                OUTPUT_VARIABLE export_out_blank_out ERROR_VARIABLE export_out_blank_err)
foreach(prefix export_out_empty export_out_last export_out_option export_out_blank)
    string(FIND "${${prefix}_err}" "--out" at)
    if(NOT ${prefix}_code EQUAL 2 OR at LESS 0)
        message(FATAL_ERROR "${prefix} ended with ${${prefix}_code}, not 2, or did not name --out: ${${prefix}_err}")
    endif()
endforeach()

# ---- an --out whose parent is a regular file: exit 1, the path in the message, and no file
set(parent_file "${dir}/notafolder")
file(WRITE "${parent_file}" "a file\n")
set(bad_out "${parent_file}/logs.zip")
engine(export_bad_parent logs export "--game=${program}" "--out=${bad_out}")
string(FIND "${export_bad_parent_err}" "${bad_out}" at)
if(NOT export_bad_parent_code EQUAL 1 OR at LESS 0 OR EXISTS "${bad_out}")
    message(FATAL_ERROR "logs export under a file ended with ${export_bad_parent_code}, not 1, or made ${bad_out}: ${export_bad_parent_err}")
endif()

# ---- logs export: the zip at --out, its entries and the text of one of them
set(zip "${dir}/logs.zip")
engine(export logs export "--game=${program}" "--out=${zip}")
if(NOT export_code EQUAL 0 OR NOT "${export_err}" STREQUAL "")
    message(FATAL_ERROR "logs export ended with ${export_code}: ${export_err}")
endif()
string(FIND "${export_out}" "${zip}" at)
if(at LESS 0)
    message(FATAL_ERROR "logs export did not print the zip's path:\n${export_out}")
endif()
if(NOT EXISTS "${zip}")
    message(FATAL_ERROR "logs export wrote no ${zip}")
endif()
set(outdir "${dir}/extracted")
file(MAKE_DIRECTORY "${outdir}")
file(ARCHIVE_EXTRACT INPUT "${zip}" DESTINATION "${outdir}")
foreach(entry "Fake.log" "logs/2026-01-01_00-00-00.log" "threads.txt" "Fake.ini" "scarletnx-error.log"
              "summary.txt")
    if(NOT EXISTS "${outdir}/${entry}")
        message(FATAL_ERROR "logs export's zip has no ${entry}")
    endif()
endforeach()
file(READ "${outdir}/Fake.log" entry_text)
if(NOT entry_text STREQUAL "the game log\n")
    message(FATAL_ERROR "logs export's Fake.log is \"${entry_text}\", not the game log")
endif()
file(READ "${outdir}/scarletnx-error.log" early_text)
if(NOT early_text STREQUAL "an early error\n")
    message(FATAL_ERROR "logs export's scarletnx-error.log is \"${early_text}\", not the early error")
endif()

# ---- a missing threads.txt: exit 0, named in summary.txt
file(REMOVE "${threads}")
set(zip2 "${dir}/logs-missing.zip")
engine(export_missing logs export "--game=${program}" "--out=${zip2}")
if(NOT export_missing_code EQUAL 0 OR NOT "${export_missing_err}" STREQUAL "")
    message(FATAL_ERROR "logs export without threads.txt ended with ${export_missing_code}: ${export_missing_err}")
endif()
set(outdir2 "${dir}/extracted-missing")
file(MAKE_DIRECTORY "${outdir2}")
file(ARCHIVE_EXTRACT INPUT "${zip2}" DESTINATION "${outdir2}")
file(READ "${outdir2}/summary.txt" summary)
string(FIND "${summary}" "threads.txt" at)
if(at LESS 0)
    message(FATAL_ERROR "logs export's summary.txt does not name threads.txt:\n${summary}")
endif()
string(REGEX MATCH "threads\\.txt \\([^)]+\\)" summary_reason "${summary}")
if(NOT summary_reason)
    message(FATAL_ERROR "logs export's summary.txt does not give the reason for the missing threads.txt:\n${summary}")
endif()
file(WRITE "${threads}" "second 1, frames 2\n")

# ---- no --out: one <name>-logs-<date>_<time>.zip in the state folder
engine(export_default logs export "--game=${program}")
if(NOT export_default_code EQUAL 0 OR NOT "${export_default_err}" STREQUAL "")
    message(FATAL_ERROR "logs export with no --out ended with ${export_default_code}: ${export_default_err}")
endif()
file(GLOB made_zips "${game_state}/*-logs-*.zip")
list(LENGTH made_zips zip_count)
if(NOT zip_count EQUAL 1)
    message(FATAL_ERROR "logs export with no --out wrote ${zip_count} zips in ${game_state}, not 1")
endif()

# ---- cache clean with no flag: the shader cache and the code cache gone, units stays, and no units line
file(MAKE_DIRECTORY "${shaders}")
file(WRITE "${shaders}/vk_pipelines.bin" "pipelines")
file(WRITE "${jitcache}" "code")
file(WRITE "${units}/keep.txt" "units")
engine(clean_all cache clean "--game=${program}")
if(NOT clean_all_code EQUAL 0 OR NOT "${clean_all_err}" STREQUAL "")
    message(FATAL_ERROR "cache clean ended with ${clean_all_code}: ${clean_all_err}")
endif()
if(EXISTS "${shaders}" OR EXISTS "${jitcache}")
    message(FATAL_ERROR "cache clean left the shader or the code cache")
endif()
if(NOT EXISTS "${units}")
    message(FATAL_ERROR "cache clean deleted units without --units")
endif()
string(FIND "${clean_all_out}" "(shared by all games of the data folder)" at)
if(NOT at LESS 0)
    message(FATAL_ERROR "cache clean with no flag printed a units line:\n${clean_all_out}")
endif()

# ---- --shaders: only the shader cache, the code cache stays
file(MAKE_DIRECTORY "${shaders}")
file(WRITE "${shaders}/vk_pipelines.bin" "pipelines")
file(WRITE "${jitcache}" "code")
engine(clean_shaders cache clean "--game=${program}" --shaders)
if(NOT clean_shaders_code EQUAL 0)
    message(FATAL_ERROR "cache clean --shaders ended with ${clean_shaders_code}: ${clean_shaders_err}")
endif()
if(EXISTS "${shaders}" OR NOT EXISTS "${jitcache}")
    message(FATAL_ERROR "cache clean --shaders deleted the wrong cache")
endif()

# ---- --code: only the code cache, the shader cache stays
file(MAKE_DIRECTORY "${shaders}")
file(WRITE "${shaders}/vk_pipelines.bin" "pipelines")
file(WRITE "${jitcache}" "code")
engine(clean_code cache clean "--game=${program}" --code)
if(NOT clean_code_code EQUAL 0)
    message(FATAL_ERROR "cache clean --code ended with ${clean_code_code}: ${clean_code_err}")
endif()
if(EXISTS "${jitcache}" OR NOT EXISTS "${shaders}")
    message(FATAL_ERROR "cache clean --code deleted the wrong cache")
endif()

# ---- --shaders --code: both caches gone, and units stays
file(MAKE_DIRECTORY "${shaders}")
file(WRITE "${shaders}/vk_pipelines.bin" "pipelines")
file(WRITE "${jitcache}" "code")
file(MAKE_DIRECTORY "${units}")
file(WRITE "${units}/keep.txt" "units")
engine(clean_both cache clean "--game=${program}" --shaders --code)
if(NOT clean_both_code EQUAL 0)
    message(FATAL_ERROR "cache clean --shaders --code ended with ${clean_both_code}: ${clean_both_err}")
endif()
if(EXISTS "${shaders}" OR EXISTS "${jitcache}" OR NOT EXISTS "${units}")
    message(FATAL_ERROR "cache clean --shaders --code deleted the wrong cache")
endif()

# ---- --units: only the shared unit cache, and the line says that it is shared
file(MAKE_DIRECTORY "${shaders}")
file(WRITE "${shaders}/vk_pipelines.bin" "pipelines")
file(WRITE "${jitcache}" "code")
file(MAKE_DIRECTORY "${units}")
file(WRITE "${units}/keep.txt" "units")
engine(clean_units cache clean "--game=${program}" --units)
if(NOT clean_units_code EQUAL 0)
    message(FATAL_ERROR "cache clean --units ended with ${clean_units_code}: ${clean_units_err}")
endif()
if(EXISTS "${units}")
    message(FATAL_ERROR "cache clean --units left units")
endif()
if(NOT EXISTS "${shaders}" OR NOT EXISTS "${jitcache}")
    message(FATAL_ERROR "cache clean --units deleted the shader or the code cache")
endif()
string(FIND "${clean_units_out}" "shared by all games of the data folder" at)
if(at LESS 0)
    message(FATAL_ERROR "cache clean --units does not say that the unit cache is shared:\n${clean_units_out}")
endif()

# ---- a second run: not present, and exit 0
engine(clean_again cache clean "--game=${program}")
if(NOT clean_again_code EQUAL 0)
    message(FATAL_ERROR "the cache clean after --units ended with ${clean_again_code}: ${clean_again_err}")
endif()
engine(clean_again2 cache clean "--game=${program}")
if(NOT clean_again2_code EQUAL 0)
    message(FATAL_ERROR "the second cache clean ended with ${clean_again2_code}: ${clean_again2_err}")
endif()
string(FIND "${clean_again2_out}" "not present" at)
if(at LESS 0)
    message(FATAL_ERROR "the second cache clean did not print not present:\n${clean_again2_out}")
endif()

# ---- a --game that is not there: exit 3, the path in the message, and nothing written
set(gone_program "${dir}/nowhere/Game.exe")
engine(export_nogame logs export "--game=${gone_program}" "--out=${dir}/nothing.zip")
engine(clean_nogame cache clean "--game=${gone_program}")
foreach(prefix export_nogame clean_nogame)
    string(FIND "${${prefix}_err}" "${gone_program}" at)
    if(NOT ${prefix}_code EQUAL 3 OR at LESS 0)
        message(FATAL_ERROR "${prefix} ended with ${${prefix}_code}, not 3, or did not name the path: ${${prefix}_err}")
    endif()
endforeach()
if(EXISTS "${dir}/nothing.zip")
    message(FATAL_ERROR "logs export with no game wrote ${dir}/nothing.zip")
endif()

# ---- an add-on's program: exit 2, as settings get and settings set refuse it, and nothing written
set(addon_base "0100000000010000")
set(addon_program "${data}/recompiled/${addon_base}/${addon_base}_0100000000010800v65536")
file(MAKE_DIRECTORY "${data}/recompiled/${addon_base}")
file(WRITE "${addon_program}" "")
engine(export_addon logs export "--game=${addon_program}" "--out=${dir}/addon.zip")
engine(clean_addon cache clean "--game=${addon_program}" --shaders)
foreach(prefix export_addon clean_addon)
    string(FIND "${${prefix}_err}" "${addon_program}" at)
    if(NOT ${prefix}_code EQUAL 2 OR at LESS 0)
        message(FATAL_ERROR "${prefix} ended with ${${prefix}_code}, not 2, or did not name the path: ${${prefix}_err}")
    endif()
endforeach()
if(EXISTS "${dir}/addon.zip")
    message(FATAL_ERROR "logs export of an add-on wrote ${dir}/addon.zip")
endif()

# ---- usage errors: exit 2, one error line, and nothing written or deleted
file(MAKE_DIRECTORY "${shaders}")
file(WRITE "${shaders}/vk_pipelines.bin" "pipelines")
file(WRITE "${jitcache}" "code")
engine(usage_logs logs)
engine(usage_logs_word logs import)
engine(usage_cache cache clean --bad "--game=${program}")
engine(usage_export_game logs export)
engine(usage_clean_game cache clean)
foreach(prefix usage_logs usage_logs_word usage_cache usage_export_game usage_clean_game)
    if(NOT ${prefix}_code EQUAL 2)
        message(FATAL_ERROR "${prefix} ended with ${${prefix}_code}, not 2")
    endif()
    if("${${prefix}_err}" STREQUAL "")
        message(FATAL_ERROR "${prefix} printed no error line")
    endif()
endforeach()
if(NOT EXISTS "${shaders}" OR NOT EXISTS "${jitcache}")
    message(FATAL_ERROR "a usage error deleted a cache")
endif()
file(GLOB made_zips "${game_state}/*-logs-*.zip")
list(LENGTH made_zips zip_count)
if(NOT zip_count EQUAL 1) # the one the default export made
    message(FATAL_ERROR "a usage error wrote a zip: ${made_zips}")
endif()

file(REMOVE_RECURSE "${dir}")
