# The .ini write-back of runtime/options.c: a file with a key the store cannot keep is left byte for byte, with the WARN
# line and no .tmp file, and a file the store keeps is written back. The game is the ABI fixture module, whose program
# the data folder lacks, so the run stops after ini_open. Run by ctest as runtime_settings_partial
if(NOT DEFINED RUNTIME OR NOT DEFINED MODULE OR NOT DEFINED ABI_HEADER)
    message(FATAL_ERROR "runtime_settings_partial needs RUNTIME, MODULE and ABI_HEADER")
endif()
file(STRINGS "${ABI_HEADER}" abi_line REGEX "^#define SNX_ABI +[0-9]+")
if(NOT abi_line MATCHES "SNX_ABI +([0-9]+)")
    message(FATAL_ERROR "no SNX_ABI in ${ABI_HEADER}")
endif()
set(ENV{SNX_TEST_MODULE_ABI} "${CMAKE_MATCH_1}")
if(WIN32)
    set(module_suffix "_code.dll")
else()
    set(module_suffix "_code.so")
endif()
set(dir "${CMAKE_CURRENT_BINARY_DIR}/settings-partial")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}")
# the user's folders in the temporary one, so the run leaves nothing of the person who starts it
set(env "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY SDL_VIDEO_DRIVER=dummy)
foreach(home HOME XDG_DATA_HOME XDG_CONFIG_HOME XDG_STATE_HOME XDG_CACHE_HOME APPDATA LOCALAPPDATA)
    file(MAKE_DIRECTORY "${dir}/${home}")
    set(ENV{${home}} "${dir}/${home}")
endforeach()

# the game named name: the ABI fixture module as its code, an empty ExeFS, and its folders recorded beside it
function(make_game name)
    set(folder "${dir}/${name}")
    file(MAKE_DIRECTORY "${folder}/config" "${folder}/state" "${folder}/cache" "${folder}/${name}_data/exefs")
    file(WRITE "${folder}/${name}.folders"
         "config=${folder}/config\nstate=${folder}/state\ncache=${folder}/cache\n")
    file(COPY_FILE "${MODULE}" "${folder}/${name}${module_suffix}")
endfunction()

# the game named name, played headless; the run stops on the game's program, which its data folder lacks
function(run_game name code_var out_var)
    set(folder "${dir}/${name}")
    execute_process(COMMAND ${env} "${RUNTIME}" "--game=${folder}/${name}" -H
                    WORKING_DIRECTORY "${folder}" TIMEOUT 30 RESULT_VARIABLE code
                    OUTPUT_VARIABLE out ERROR_VARIABLE out)
    set(${code_var} "${code}" PARENT_SCOPE)
    set(${out_var} "${out}" PARENT_SCOPE)
endfunction()

# 257 distinct keys: the store keeps at most 256, so the file is not written and has no .tmp file
make_game(partial)
set(ini "${dir}/partial/config/partial.ini")
set(keys "")
foreach(i RANGE 1 257)
    string(APPEND keys "k${i}=v${i}\n")
endforeach()
file(WRITE "${ini}" "${keys}")
file(SHA256 "${ini}" before)
run_game(partial code out)
if(EXISTS "${ini}.tmp")
    message(FATAL_ERROR "257 keys: the run left ${ini}.tmp")
endif()
file(SHA256 "${ini}" after)
if(NOT before STREQUAL after)
    message(FATAL_ERROR "257 keys: the run changed ${ini}")
endif()
if(NOT code EQUAL 3)
    message(FATAL_ERROR "257 keys: the run ended with ${code}, not 3, before the game's program: \n${out}")
endif()
string(FIND "${out}" "has keys that the store cannot keep" warned)
string(FIND "${out}" "the file is not written in this run, so changes made in the game are not saved" unsaved)
if(warned LESS 0 OR unsaved LESS 0)
    message(FATAL_ERROR "257 keys: no WARN line that the file is not written: \n${out}")
endif()

# 256 distinct keys: the store keeps them all, so the file is written back and its bytes change
make_game(written)
set(ini "${dir}/written/config/written.ini")
set(keys "")
foreach(i RANGE 1 256)
    string(APPEND keys "k${i}=v${i}\n")
endforeach()
file(WRITE "${ini}" "${keys}")
file(SHA256 "${ini}" before)
run_game(written code out)
if(EXISTS "${ini}.tmp")
    message(FATAL_ERROR "256 keys: the run left ${ini}.tmp")
endif()
file(SHA256 "${ini}" after)
if(before STREQUAL after)
    message(FATAL_ERROR "256 keys: the run did not write ${ini}")
endif()
if(NOT code EQUAL 3)
    message(FATAL_ERROR "256 keys: the run ended with ${code}, not 3, before the game's program: \n${out}")
endif()
string(FIND "${out}" "has keys that the store cannot keep" warned)
if(NOT warned LESS 0)
    message(FATAL_ERROR "256 keys: the run says that the file is not written: \n${out}")
endif()

file(REMOVE_RECURSE "${dir}")
