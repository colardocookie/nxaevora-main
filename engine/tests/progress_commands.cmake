# The JSON Lines progress stream of recompile and run (common/utilities/progress.c): the exact event lines, the codes,
# and no human text on stdout. Run by ctest as runtime_progress_commands
cmake_minimum_required(VERSION 3.25)
set(dir "${CMAKE_CURRENT_BINARY_DIR}/progress-commands")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}")
set(env "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY SDL_VIDEO_DRIVER=dummy)
function(engine prefix)
    execute_process(COMMAND ${env} "${RUNTIME}" ${ARGN}
                    WORKING_DIRECTORY "${dir}" TIMEOUT 20 RESULT_VARIABLE code
                    OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set("${prefix}_code" "${code}" PARENT_SCOPE)
    set("${prefix}_out" "${out}" PARENT_SCOPE)
    set("${prefix}_err" "${err}" PARENT_SCOPE)
endfunction()
# recompile and run name a missing input: exit 3, the input stage's start and error lines, the exit line, and no other
# stdout line (any human text on stdout would break the count or the first `{`)
foreach(command recompile run)
    engine(${command} ${command} missing.nro --progress=jsonl)
    if(NOT ${command}_code EQUAL 3)
        message(FATAL_ERROR "${command} missing.nro --progress=jsonl ended with ${${command}_code}, not 3")
    endif()
    string(REPLACE "\n" ";" lines "${${command}_out}")
    list(LENGTH lines line_count)
    math(EXPR last "${line_count} - 1")
    list(GET lines ${last} tail)
    if(NOT tail STREQUAL "")
        message(FATAL_ERROR "${command}: stdout does not end with a newline:\n${${command}_out}")
    endif()
    list(REMOVE_AT lines ${last})
    list(LENGTH lines line_count)
    if(NOT line_count EQUAL 3)
        message(FATAL_ERROR "${command}: stdout has ${line_count} lines, not 3:\n${${command}_out}")
    endif()
    foreach(line IN LISTS lines)
        string(SUBSTRING "${line}" 0 1 first_byte)
        if(NOT first_byte STREQUAL "{")
            message(FATAL_ERROR "${command}: stdout has a line that is not JSON: ${line}")
        endif()
    endforeach()
    list(GET lines 0 first)
    if(NOT first STREQUAL "{\"v\":1,\"stage\":\"input\",\"event\":\"start\"}")
        message(FATAL_ERROR "${command}: the first line is not the input start: ${first}")
    endif()
    list(GET lines 1 second)
    string(FIND "${second}" "\"stage\":\"input\"" at_stage)
    string(FIND "${second}" "\"event\":\"error\"" at_event)
    string(FIND "${second}" "\"message\":\"" at_message)
    string(FIND "${second}" "\"code\":3}" at_code)
    if(at_stage LESS 0 OR at_event LESS 0 OR at_message LESS 0 OR at_code LESS 0)
        message(FATAL_ERROR "${command}: the second line is not the input error with code 3: ${second}")
    endif()
    list(GET lines 2 third)
    if(NOT third STREQUAL "{\"v\":1,\"event\":\"exit\",\"code\":3}")
        message(FATAL_ERROR "${command}: the last line is not the exit line with code 3: ${third}")
    endif()
    string(FIND "${${command}_err}" "missing.nro" at_error)
    if(at_error LESS 0)
        message(FATAL_ERROR "${command}: stderr has no human error text:\n${${command}_err}")
    endif()
endforeach()
# a bad value is exit 2, with a usage message on stderr and no stream on stdout
foreach(command recompile run)
    engine(${command}_bad ${command} missing.nro --progress=bad)
    if(NOT ${command}_bad_code EQUAL 2)
        message(FATAL_ERROR "${command} --progress=bad ended with ${${command}_bad_code}, not 2")
    endif()
    string(FIND "${${command}_bad_err}" "progress" at_bad)
    if(at_bad LESS 0)
        message(FATAL_ERROR "${command} --progress=bad: stderr has no usage message:\n${${command}_bad_err}")
    endif()
endforeach()
# a usage error found while the options are read: exit 2 and no stream line on stdout
engine(recompile_unknown recompile --progress=jsonl --bogus missing.nro)
if(NOT recompile_unknown_code EQUAL 2)
    message(FATAL_ERROR "recompile --progress=jsonl --bogus ended with ${recompile_unknown_code}, not 2")
endif()
if(NOT recompile_unknown_out STREQUAL "")
    message(FATAL_ERROR "recompile --progress=jsonl --bogus wrote to stdout:\n${recompile_unknown_out}")
endif()
# run keeps --progress=jsonl for the driver, which opens the stream after its own checks: the same usage error writes
# no stream line
engine(run_unknown run missing.nro --progress=jsonl --bogus=1)
if(NOT run_unknown_code EQUAL 2)
    message(FATAL_ERROR "run --progress=jsonl --bogus=1 ended with ${run_unknown_code}, not 2")
endif()
if(NOT run_unknown_out STREQUAL "")
    message(FATAL_ERROR "run --progress=jsonl --bogus=1 wrote to stdout:\n${run_unknown_out}")
endif()
# the internal stage mode is not a public value: exit 2
foreach(command recompile run)
    engine(${command}_stage ${command} missing.nro --progress=jsonl-stage)
    if(NOT ${command}_stage_code EQUAL 2)
        message(FATAL_ERROR "${command} missing.nro --progress=jsonl-stage ended with ${${command}_stage_code}, not 2")
    endif()
endforeach()
file(REMOVE_RECURSE "${dir}")
