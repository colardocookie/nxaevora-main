# `settings schema`, `settings get`, `settings set` and `settings check` (runtime/settings_cli.c): the definition as
# one JSON document, one value of the game's .ini printed or written, and one value checked with no file. The rows, the
# ranges and the defaults come from settings.txt (SETTINGS_TXT, what settingsgen reads); the exit codes from
# exit_codes.h. Run by ctest as runtime_settings_commands
set(dir "${CMAKE_CURRENT_BINARY_DIR}/settings-commands")
file(REMOVE_RECURSE "${dir}")
file(MAKE_DIRECTORY "${dir}")
set(env "${CMAKE_COMMAND}" -E env --unset=DISPLAY --unset=WAYLAND_DISPLAY SDL_VIDEO_DRIVER=dummy)
function(engine prefix)
    execute_process(COMMAND ${env} "${RUNTIME}" ${ARGN}
                    WORKING_DIRECTORY "${dir}" TIMEOUT 20 RESULT_VARIABLE code
                    OUTPUT_VARIABLE out ERROR_VARIABLE err)
    set("${prefix}_code" "${code}" PARENT_SCOPE)
    set("${prefix}_out" "${out}" PARENT_SCOPE)
    set("${prefix}_err" "${err}" PARENT_SCOPE)
endfunction()

# ---- the game's settings file, with no game: the data folder the environment names (<data>), its config folder, and
# ---- a game's program that the runtime names the game by its path alone. Windows: %APPDATA%\nxaevora\config; XDG:
# ---- $XDG_CONFIG_HOME/nxaevora
set(root "${dir}/home")
if(WIN32)
    set(data "${root}/appdata/nxaevora")
    set(config "${data}/config")
    set(ENV{APPDATA} "${root}/appdata")
else()
    set(data "${root}/data/nxaevora")
    set(config "${root}/config/nxaevora")
    set(ENV{HOME} "${root}/home")
    set(ENV{XDG_DATA_HOME} "${root}/data")
    set(ENV{XDG_CONFIG_HOME} "${root}/config")
    set(ENV{XDG_STATE_HOME} "${root}/state")
    set(ENV{XDG_CACHE_HOME} "${root}/cache")
endif()
set(program "${data}/recompiled/Fake/Fake.exe")
set(ini "${config}/recompiled/Fake/Fake.ini")
file(MAKE_DIRECTORY "${data}/recompiled/Fake")
file(WRITE "${program}" "")

# ---- settings schema: one JSON document, its version, and the rows of the tables that settings.txt fully defines
engine(schema settings schema)
if(NOT schema_code EQUAL 0 OR NOT "${schema_err}" STREQUAL "")
    message(FATAL_ERROR "settings schema ended with ${schema_code}: ${schema_err}")
endif()
string(STRIP "${schema_out}" schema)
string(JSON v GET "${schema}" v)
string(JSON entries LENGTH "${schema}" settings)
if(NOT v EQUAL 1)
    message(FATAL_ERROR "settings schema's v is ${v}, not 1")
endif()
# the rows of settings.txt's tables, the unattended options' (no section) and the LLVM Internals' (an LLVM install
# decides them) left out: a setting's rows are its `each` list's count, a repeat block's are its settings' times N
# a semicolon in a line (a help text has one) would split the list: escaped, the lines come whole
file(READ "${SETTINGS_TXT}" settings_text)
string(REPLACE ";" "\\;" settings_text "${settings_text}")
string(REPLACE "\r\n" "\n" settings_text "${settings_text}")
string(REPLACE "\n" ";" lines "${settings_text}")
foreach(line IN LISTS lines)
    if(line MATCHES "^list +([A-Za-z0-9_]+) +(.*)$")
        set(list_name "${CMAKE_MATCH_1}")
        string(REPLACE " " ";" ids "${CMAKE_MATCH_2}")
        list(LENGTH ids count)
        set(list_count_${list_name} ${count})
    endif()
endforeach()
set(expected 0)
set(skip FALSE)
set(repeat 1)
list(LENGTH lines line_count)
math(EXPR last "${line_count} - 1")
foreach(i RANGE ${last})
    list(GET lines ${i} line)
    if(line MATCHES "^table +([A-Za-z0-9_]+)")
        set(skip FALSE)
        if(CMAKE_MATCH_1 STREQUAL "g_unattended_ini" OR CMAKE_MATCH_1 STREQUAL "g_llvm_ini")
            set(skip TRUE)
        endif()
        set(repeat 1)
    elseif(line MATCHES "^repeat +([0-9]+)")
        set(repeat "${CMAKE_MATCH_1}")
    elseif(line STREQUAL "end")
        set(repeat 1)
    elseif(line MATCHES "^setting ")
        set(rows 1)
        math(EXPR next "${i} + 1")
        while(next LESS line_count)
            list(GET lines ${next} field)
            if(field MATCHES "^    each +([A-Za-z0-9_]+)")
                set(rows ${list_count_${CMAKE_MATCH_1}})
                break()
            endif()
            if(NOT field MATCHES "^    ")
                break()
            endif()
            math(EXPR next "${next} + 1")
        endwhile()
        if(NOT skip)
            math(EXPR expected "${expected} + ${repeat} * ${rows}")
        endif()
    endif()
endforeach()
if(expected LESS 1)
    message(FATAL_ERROR "settings.txt gives no row to count")
endif()
# the LLVM Internals' rows are the page of the Launch section that only they have
set(defined 0)
set(llvm 0)
math(EXPR last "${entries} - 1")
foreach(i RANGE ${last})
    string(JSON section GET "${schema}" settings ${i} section)
    string(JSON page GET "${schema}" settings ${i} page)
    if(section STREQUAL "Launch" AND page STREQUAL "LLVM Internals")
        math(EXPR llvm "${llvm} + 1")
    else()
        math(EXPR defined "${defined} + 1")
    endif()
endforeach()
if(NOT defined EQUAL expected)
    message(FATAL_ERROR "settings schema has ${defined} entries of settings.txt's tables, which has ${expected} rows")
endif()
if(llvm LESS 1)
    message(FATAL_ERROR "settings schema has no entry of the LLVM Internals' page")
endif()

# the fields of two rows, as settings.txt writes them: an int with a range and words (render_resolution: int 0 3,
# default 1, a startup setting of Graphics) and a text with no default (gamepad_map: text 192, Controllers/Button map)
function(schema_entry key)
    set(found -1)
    math(EXPR last "${entries} - 1")
    foreach(i RANGE ${last})
        if(found LESS 0)
            string(JSON k GET "${schema}" settings ${i} key)
            if(k STREQUAL "${key}")
                set(found ${i})
            endif()
        endif()
    endforeach()
    set(index ${found} PARENT_SCOPE)
endfunction()
function(expect_field key field value)
    schema_entry("${key}")
    if(index LESS 0)
        message(FATAL_ERROR "settings schema has no ${key}")
    endif()
    string(JSON got GET "${schema}" settings ${index} ${field})
    if(NOT got STREQUAL "${value}")
        message(FATAL_ERROR "settings schema's ${key}'s ${field} is \"${got}\", not \"${value}\"")
    endif()
endfunction()
# a field with no value is JSON null, which string(JSON GET) cannot tell from an empty string
function(expect_null key field)
    schema_entry("${key}")
    if(index LESS 0)
        message(FATAL_ERROR "settings schema has no ${key}")
    endif()
    string(JSON kind TYPE "${schema}" settings ${index} ${field})
    if(NOT kind STREQUAL "NULL")
        message(FATAL_ERROR "settings schema's ${key}'s ${field} is ${kind}, not null")
    endif()
endfunction()
expect_field(render_resolution type int)
expect_field(render_resolution section Graphics)
expect_field(render_resolution min 0)
expect_field(render_resolution max 3)
expect_field(render_resolution default 1)
expect_field(render_resolution words "720p|1080p|1440p|2160p")
expect_field(render_resolution scope startup)
expect_null(render_resolution page) # section Graphics: g_graphics_ini has no page
expect_field(gamepad_map type text)
expect_field(gamepad_map section Controllers)
expect_field(gamepad_map page "Button map")
expect_null(gamepad_map min)
expect_null(gamepad_map max)
expect_null(gamepad_map default)
expect_field(gamepad_map scope in-game)
# the game's own rows are in the schema, unlike the nine-field settings text
expect_field(controls_a key controls_a)
expect_field(controls_a scope in-game)
engine(schema_extra settings schema extra)
if(NOT schema_extra_code EQUAL 2)
    message(FATAL_ERROR "settings schema extra ended with ${schema_extra_code}, not 2")
endif()

# ---- settings check: the value against the row only, no file and no --game
engine(check_ok settings check render_resolution 3)
if(NOT check_ok_code EQUAL 0 OR NOT "${check_ok_out}" STREQUAL "" OR NOT "${check_ok_err}" STREQUAL "")
    message(FATAL_ERROR "settings check render_resolution 3 ended with ${check_ok_code}: ${check_ok_err}")
endif()
engine(check_high settings check render_resolution 4) # int 0 3
string(FIND "${check_high_err}" "render_resolution" at)
if(NOT check_high_code EQUAL 7 OR at LESS 0)
    message(FATAL_ERROR "settings check render_resolution 4 ended with ${check_high_code}, not 7: ${check_high_err}")
endif()
# no setting has a float type, so a fractional value is refused by an int row: exit 7
engine(check_fraction settings check render_resolution 1.5)
string(FIND "${check_fraction_err}" "render_resolution" at)
if(NOT check_fraction_code EQUAL 7 OR at LESS 0)
    message(FATAL_ERROR "settings check render_resolution 1.5 ended with ${check_fraction_code}, not 7: ${check_fraction_err}")
endif()
engine(check_text settings check gamepad_map "south:B")
if(NOT check_text_code EQUAL 0)
    message(FATAL_ERROR "settings check gamepad_map with 7 bytes ended with ${check_text_code}, not 0")
endif()
string(REPEAT "a" 192 long) # gamepad_map is text 192: 192 bytes do not fit
engine(check_long settings check gamepad_map "${long}")
string(FIND "${check_long_err}" "gamepad_map" at)
if(NOT check_long_code EQUAL 7 OR at LESS 0)
    message(FATAL_ERROR "settings check gamepad_map with ${long} ended with ${check_long_code}, not 7")
endif()
engine(check_unknown settings check bogus_setting 1)
if(NOT check_unknown_code EQUAL 2)
    message(FATAL_ERROR "settings check bogus_setting ended with ${check_unknown_code}, not 2")
endif()
# check takes every key of the settings definition, the launcher's and the recompiler's rows too: gdbstub
# (g_launch_ini, text 4) holds 3 bytes, aot_threads (g_recompile_ini, int 0 1024) is 0 to 1024
engine(check_launch settings check gdbstub on)
if(NOT check_launch_code EQUAL 0)
    message(FATAL_ERROR "settings check gdbstub on ended with ${check_launch_code}, not 0")
endif()
engine(check_launch_long settings check gdbstub onon)
string(FIND "${check_launch_long_err}" "gdbstub" at)
if(NOT check_launch_long_code EQUAL 7 OR at LESS 0)
    message(FATAL_ERROR "settings check gdbstub onon ended with ${check_launch_long_code}, not 7: ${check_launch_long_err}")
endif()
engine(check_recompile settings check aot_threads 4)
if(NOT check_recompile_code EQUAL 0)
    message(FATAL_ERROR "settings check aot_threads 4 ended with ${check_recompile_code}, not 0")
endif()
engine(check_recompile_high settings check aot_threads 1025)
string(FIND "${check_recompile_high_err}" "aot_threads" at)
if(NOT check_recompile_high_code EQUAL 7 OR at LESS 0)
    message(FATAL_ERROR "settings check aot_threads 1025 ended with ${check_recompile_high_code}, not 7")
endif()
engine(check_game settings check render_resolution 3 "--game=nowhere")
if(NOT check_game_code EQUAL 2)
    message(FATAL_ERROR "settings check with --game ended with ${check_game_code}, not 2")
endif()
# a game .ini row's value that the .ini's reader does not give back as written is refused with 7, as set refuses it: a
# blank or tab at either end is trimmed, and an end carriage return ends the line
string(ASCII 9 tab)
string(ASCII 13 cr)
engine(check_blank_end settings check gamepad_map "south:B ")
engine(check_tab_end settings check gamepad_map "south:B${tab}")
engine(check_tab_start settings check gamepad_map "${tab}south:B")
engine(check_cr_end settings check gamepad_map "south:B${cr}")
foreach(prefix check_blank_end check_tab_end check_tab_start check_cr_end)
    string(FIND "${${prefix}_err}" "gamepad_map" at)
    if(NOT ${prefix}_code EQUAL 7 OR at LESS 0)
        message(FATAL_ERROR "${prefix} ended with ${${prefix}_code}, not 7: ${${prefix}_err}")
    endif()
endforeach()

# ---- settings get and set: the game's .ini, <config>/recompiled/Fake/Fake.ini
file(MAKE_DIRECTORY "${config}/recompiled/Fake")
# ---- a --game that is not there: exit 3, the path in the message
set(gone_program "${dir}/nowhere/Fake.exe")
engine(get_gone settings get render_resolution "--game=${gone_program}")
engine(set_gone settings set render_resolution 2 "--game=${gone_program}")
foreach(prefix get_gone set_gone)
    string(FIND "${${prefix}_err}" "${gone_program}" at)
    if(NOT ${prefix}_code EQUAL 3 OR at LESS 0)
        message(FATAL_ERROR "${prefix} ended with ${${prefix}_code}, not 3, or did not name the path: ${${prefix}_err}")
    endif()
endforeach()
engine(get_missing settings get render_resolution "--game=${program}")
string(FIND "${get_missing_err}" "Fake.ini" at)
if(NOT get_missing_code EQUAL 3 OR at LESS 0)
    message(FATAL_ERROR "settings get of a missing .ini ended with ${get_missing_code}, not 3: ${get_missing_err}")
endif()
engine(set_missing settings set fullscreen 1 "--game=${program}")
if(NOT set_missing_code EQUAL 3)
    message(FATAL_ERROR "settings set of a missing .ini ended with ${set_missing_code}, not 3")
endif()
file(WRITE "${ini}" "[Graphics]\nrender_resolution=1\n")
engine(set_ok settings set render_resolution 2 "--game=${program}")
if(NOT set_ok_code EQUAL 0 OR NOT "${set_ok_out}" STREQUAL "" OR NOT "${set_ok_err}" STREQUAL "")
    message(FATAL_ERROR "settings set render_resolution 2 ended with ${set_ok_code}: ${set_ok_err}")
endif()
file(READ "${ini}" written)
string(FIND "${written}" "render_resolution=2" at)
if(at LESS 0)
    message(FATAL_ERROR "settings set render_resolution 2 did not write render_resolution=2:\n${written}")
endif()
engine(get_ok settings get render_resolution "--game=${program}")
string(STRIP "${get_ok_out}" value)
if(NOT get_ok_code EQUAL 0 OR NOT value STREQUAL "2")
    message(FATAL_ERROR "settings get render_resolution after the set gave \"${value}\" with ${get_ok_code}, not 2")
endif()
# a refused value: exit 7, and the file's bytes stay
file(READ "${ini}" before_hex HEX)
engine(set_refused settings set render_resolution 9 "--game=${program}")
string(FIND "${set_refused_err}" "render_resolution" at)
file(READ "${ini}" after_hex HEX)
if(NOT set_refused_code EQUAL 7 OR at LESS 0 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings set render_resolution 9 ended with ${set_refused_code}, not 7, or changed the file")
endif()
# a value the .ini's reader cannot give back is refused too (exit 7, the file's bytes stay): it splits lines at a line
# break and trims a blank at either end (common/utilities/ini_lines.c)
string(ASCII 10 lf)
string(ASCII 13 cr)
file(READ "${ini}" before_hex HEX)
engine(set_lf settings set gamepad_map "south:B${lf}log=0" "--game=${program}")
string(FIND "${set_lf_err}" "gamepad_map" at)
file(READ "${ini}" after_hex HEX)
if(NOT set_lf_code EQUAL 7 OR at LESS 0 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings set gamepad_map with a line break ended with ${set_lf_code}, not 7, or changed the file")
endif()
engine(set_cr settings set gamepad_map "south:B${cr}log=0" "--game=${program}")
file(READ "${ini}" after_hex HEX)
if(NOT set_cr_code EQUAL 7 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings set gamepad_map with a carriage return ended with ${set_cr_code}, not 7, or changed the file")
endif()
engine(set_number_lf settings set render_resolution "${lf}3" "--game=${program}")
string(FIND "${set_number_lf_err}" "render_resolution" at)
file(READ "${ini}" after_hex HEX)
if(NOT set_number_lf_code EQUAL 7 OR at LESS 0 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings set render_resolution with a line break ended with ${set_number_lf_code}, not 7, or changed the file")
endif()
engine(set_blank settings set gamepad_map " south:B" "--game=${program}")
string(FIND "${set_blank_err}" "gamepad_map" at)
file(READ "${ini}" after_hex HEX)
if(NOT set_blank_code EQUAL 7 OR at LESS 0 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings set gamepad_map with a leading blank ended with ${set_blank_code}, not 7, or changed the file")
endif()
# a key the tables do not know stays in the file
file(WRITE "${ini}" "[Graphics]\nrender_resolution=1\n\n[Other]\nkept_key=kept\n")
engine(set_keep settings set fullscreen 1 "--game=${program}")
file(READ "${ini}" kept)
string(FIND "${kept}" "kept_key=kept" at)
if(NOT set_keep_code EQUAL 0 OR at LESS 0)
    message(FATAL_ERROR "settings set kept not kept_key: exit ${set_keep_code}:\n${kept}")
endif()
# a key the file does not have prints its default (log: int 0 2, default 1), and the file is not written
file(WRITE "${ini}" "[Graphics]\nrender_resolution=2\n")
file(READ "${ini}" before_hex HEX)
engine(get_default settings get log "--game=${program}")
string(STRIP "${get_default_out}" value)
file(READ "${ini}" after_hex HEX)
if(NOT get_default_code EQUAL 0 OR NOT value STREQUAL "1" OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings get log gave \"${value}\" with ${get_default_code}, not the default 1")
endif()
# a text with no default that the file does not have prints an empty line (gamepad_map: text 192, no default), and the
# file is not written
file(READ "${ini}" before_hex HEX)
engine(get_no_default settings get gamepad_map "--game=${program}")
string(STRIP "${get_no_default_out}" value)
file(READ "${ini}" after_hex HEX)
if(NOT get_no_default_code EQUAL 0 OR NOT "${get_no_default_err}" STREQUAL "" OR NOT value STREQUAL ""
   OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings get gamepad_map gave \"${value}\" with ${get_no_default_code}, not an empty line")
endif()
# a missing --game, and a key that is none of the game's .ini's
engine(get_nogame settings get render_resolution)
if(NOT get_nogame_code EQUAL 2)
    message(FATAL_ERROR "settings get without --game ended with ${get_nogame_code}, not 2")
endif()
engine(get_unknown settings get bogus_setting "--game=${program}")
if(NOT get_unknown_code EQUAL 2)
    message(FATAL_ERROR "settings get bogus_setting ended with ${get_unknown_code}, not 2")
endif()
# --game= with an empty value names no program: the game's files (exit_codes.h: SNX_EXIT_GAME_FILES 3)
engine(get_empty_game settings get render_resolution "--game=")
string(FIND "${get_empty_game_err}" "not there: check --game" at)
if(NOT get_empty_game_code EQUAL 3 OR at LESS 0)
    message(FATAL_ERROR "settings get --game= ended with ${get_empty_game_code}, not 3: ${get_empty_game_err}")
endif()
# the store keeps STORE_MAX keys (options.c): a file with more is refused with exit 1 (SNX_EXIT_INTERNAL, an existing
# file the command cannot use) and set writes nothing. The limit comes from options.c, not a copy of the number here
get_filename_component(test_dir "${CMAKE_SCRIPT_MODE_FILE}" DIRECTORY)
file(READ "${test_dir}/../src/nx/runtime/options.c" options_source)
if(NOT options_source MATCHES "#define STORE_MAX +([0-9]+)")
    message(FATAL_ERROR "options.c has no STORE_MAX")
endif()
set(store_max "${CMAKE_MATCH_1}")
if(NOT options_source MATCHES "#define KEY_MAX +([0-9]+)")
    message(FATAL_ERROR "options.c has no KEY_MAX")
endif()
set(key_max "${CMAKE_MATCH_1}")
if(NOT options_source MATCHES "#define VALUE_MAX +([0-9]+)")
    message(FATAL_ERROR "options.c has no VALUE_MAX")
endif()
set(value_max "${CMAKE_MATCH_1}")
set(keys "")
foreach(i RANGE 1 ${store_max})
    set(keys "${keys}unknown_key_${i}=1\n")
endforeach()
math(EXPR store_over "${store_max} + 1")
file(WRITE "${ini}" "[Other]\n${keys}unknown_key_${store_over}=1\n")
file(READ "${ini}" before_hex HEX)
engine(get_many settings get render_resolution "--game=${program}")
string(FIND "${get_many_err}" "${store_max}" at)
file(READ "${ini}" after_hex HEX)
if(NOT get_many_code EQUAL 1 OR at LESS 0 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings get of a file of ${store_over} keys ended with ${get_many_code}, not 1: ${get_many_err}")
endif()
engine(set_many settings set fullscreen 1 "--game=${program}")
file(READ "${ini}" after_hex HEX)
if(NOT set_many_code EQUAL 1 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings set of a file of ${store_over} keys ended with ${set_many_code}, not 1, or changed the file")
endif()
# exactly STORE_MAX keys, none of them fullscreen: a new key is refused (exit 1, the message says the limit, the
# file's bytes stay), a key of the file is updated
set(keys "")
math(EXPR store_last "${store_max} - 1")
foreach(i RANGE 1 ${store_last})
    set(keys "${keys}unknown_key_${i}=1\n")
endforeach()
file(WRITE "${ini}" "[Graphics]\nrender_resolution=1\n${keys}")
file(READ "${ini}" before_hex HEX)
engine(set_full settings set fullscreen 1 "--game=${program}")
string(FIND "${set_full_err}" "at most ${store_max} keys" at)
file(READ "${ini}" after_hex HEX)
if(NOT set_full_code EQUAL 1 OR at LESS 0 OR NOT before_hex STREQUAL after_hex)
    message(FATAL_ERROR "settings set of a new key in a file of ${store_max} keys ended with ${set_full_code}, not 1, or did not say \"at most ${store_max} keys\", or changed the file: ${set_full_err}")
endif()
engine(set_full_known settings set render_resolution 2 "--game=${program}")
file(READ "${ini}" written)
string(FIND "${written}" "render_resolution=2" at)
if(NOT set_full_known_code EQUAL 0 OR at LESS 0)
    message(FATAL_ERROR "settings set render_resolution in a file of ${store_max} keys ended with ${set_full_known_code}, not 0")
endif()
# a key of KEY_MAX - 1 bytes is kept, and one of KEY_MAX is refused with exit 1 (SNX_EXIT_INTERNAL, an existing file the
# command cannot use). snx_settings_save's own key check needs a known row, which is shorter, so the same KEY_MAX shows
# through the file's store (options.c)
math(EXPR key_ok "${key_max} - 1")
string(REPEAT "k" ${key_ok} key_at)
string(REPEAT "k" ${key_max} key_over)
file(WRITE "${ini}" "[Other]\n${key_at}=1\n")
engine(get_key_at settings get render_resolution "--game=${program}")
if(NOT get_key_at_code EQUAL 0)
    message(FATAL_ERROR "settings get of a ${key_ok}-byte key ended with ${get_key_at_code}, not 0: ${get_key_at_err}")
endif()
file(WRITE "${ini}" "[Other]\n${key_over}=1\n")
engine(get_key_over settings get render_resolution "--game=${program}")
if(NOT get_key_over_code EQUAL 1)
    message(FATAL_ERROR "settings get of a ${key_max}-byte key ended with ${get_key_over_code}, not 1: ${get_key_over_err}")
endif()
# a value of VALUE_MAX - 1 bytes is kept, and one of VALUE_MAX is refused with exit 7 (SNX_EXIT_SETTING): source is a
# game .ini text row of VALUE_MAX bytes, so its row takes VALUE_MAX - 1 too (settings.txt, ini.c ini_check)
math(EXPR value_ok "${value_max} - 1")
string(REPEAT "a" ${value_ok} value_at)
string(REPEAT "a" ${value_max} value_over)
file(WRITE "${ini}" "[Graphics]\nrender_resolution=1\n")
engine(set_value_at settings set source "${value_at}" "--game=${program}")
if(NOT set_value_at_code EQUAL 0)
    message(FATAL_ERROR "settings set source of ${value_ok} bytes ended with ${set_value_at_code}: ${set_value_at_err}")
endif()
file(READ "${ini}" written)
string(FIND "${written}" "source=${value_at}" at)
if(at LESS 0)
    message(FATAL_ERROR "settings set source of ${value_ok} bytes did not write source=${value_ok} bytes to the .ini")
endif()
engine(set_value_over settings set source "${value_over}" "--game=${program}")
string(FIND "${set_value_over_err}" "source" at)
if(NOT set_value_over_code EQUAL 7 OR at LESS 0)
    message(FATAL_ERROR "settings set source of ${value_max} bytes ended with ${set_value_over_code}, not 7: ${set_value_over_err}")
endif()
# an update's program (main.c addon_init: <folder>/<folder>_<the update's title ID>) is refused, since a run opens the
# base game's .ini: exit 2, and stderr names the path
set(game_id "0100000000010000")
set(update_program "${data}/recompiled/${game_id}/${game_id}_0100000000010800v65536")
file(MAKE_DIRECTORY "${data}/recompiled/${game_id}")
file(WRITE "${update_program}" "")
engine(get_update settings get render_resolution "--game=${update_program}")
string(FIND "${get_update_err}" "${update_program}" at)
if(NOT get_update_code EQUAL 2 OR at LESS 0)
    message(FATAL_ERROR "settings get of an update's program ended with ${get_update_code}, not 2: ${get_update_err}")
endif()
engine(set_update settings set render_resolution 2 "--game=${update_program}")
string(FIND "${set_update_err}" "${update_program}" at)
if(NOT set_update_code EQUAL 2 OR at LESS 0)
    message(FATAL_ERROR "settings set of an update's program ended with ${set_update_code}, not 2: ${set_update_err}")
endif()
# a DLC's program (<folder>/<folder>_<the DLC's title ID>, no version) is refused the same way: its run opens the
# base game's .ini too
set(dlc_program "${data}/recompiled/${game_id}/${game_id}_0100000000011000")
file(WRITE "${dlc_program}" "")
engine(get_dlc settings get render_resolution "--game=${dlc_program}")
string(FIND "${get_dlc_err}" "${dlc_program}" at)
if(NOT get_dlc_code EQUAL 2 OR at LESS 0)
    message(FATAL_ERROR "settings get of a DLC's program ended with ${get_dlc_code}, not 2: ${get_dlc_err}")
endif()
engine(set_dlc settings set render_resolution 2 "--game=${dlc_program}")
string(FIND "${set_dlc_err}" "${dlc_program}" at)
if(NOT set_dlc_code EQUAL 2 OR at LESS 0)
    message(FATAL_ERROR "settings set of a DLC's program ended with ${set_dlc_code}, not 2: ${set_dlc_err}")
endif()

# ---- --help: the five words, each with the usage line that docs/records/ui/engine-ui-plan.md's "Commands" gives it. --help
# ---- with any other argument is exit 2, the one rule they share
engine(help_settings settings --help)
if(NOT help_settings_code EQUAL 0 OR NOT "${help_settings_err}" STREQUAL "")
    message(FATAL_ERROR "settings --help ended with ${help_settings_code}: ${help_settings_err}")
endif()
string(FIND "${help_settings_out}" "Usage: nxaevora-engine settings" at)
if(at LESS 0)
    message(FATAL_ERROR "settings --help has no usage line:\n${help_settings_out}")
endif()
foreach(form "list [--scope=game|recompile]" "get KEY --game=PATH" "set KEY VALUE --game=PATH"
             "check KEY VALUE")
    string(FIND "${help_settings_out}" "${form}" at)
    if(at LESS 0)
        message(FATAL_ERROR "settings --help does not name \"${form}\":\n${help_settings_out}")
    endif()
endforeach()
engine(help_list settings list --help)
engine(help_schema settings schema --help)
engine(help_get settings get --help)
engine(help_set settings set --help)
engine(help_check settings check --help)
set(names "help_list" "help_schema" "help_get" "help_set" "help_check")
set(lines "settings list [--scope=game|recompile]" "settings schema" "settings get KEY --game=PATH"
          "settings set KEY VALUE --game=PATH" "settings check KEY VALUE")
list(LENGTH names count)
math(EXPR last "${count} - 1")
foreach(i RANGE ${last})
    list(GET names ${i} prefix)
    list(GET lines ${i} line)
    if(NOT ${prefix}_code EQUAL 0 OR NOT "${${prefix}_err}" STREQUAL "")
        message(FATAL_ERROR "${line} --help ended with ${${prefix}_code}: ${${prefix}_err}")
    endif()
    string(FIND "${${prefix}_out}" "${line}" at)
    if(at LESS 0)
        message(FATAL_ERROR "--help has no \"${line}\" usage line:\n${${prefix}_out}")
    endif()
endforeach()
foreach(case "settings --help extra" "settings list --scope=game --help" "settings schema --help extra"
             "settings get render_resolution --help" "settings set render_resolution 1 --help"
             "settings check render_resolution 1 --help")
    separate_arguments(args UNIX_COMMAND "${case}")
    engine(bad_help ${args})
    if(NOT bad_help_code EQUAL 2)
        message(FATAL_ERROR "nxaevora-engine ${case} ended with ${bad_help_code}, not 2")
    endif()
endforeach()
# the message names the extra word and calls it neither an option nor an argument (command.c snx_command_help), with
# no stdout
engine(help_extra settings --help extra)
engine(help_scope settings list --scope=game --help)
foreach(case "help_extra|settings: --help takes no other word: extra"
             "help_scope|settings list: --help takes no other word: --scope=game")
    string(REPLACE "|" ";" fields "${case}")
    list(GET fields 0 prefix)
    list(GET fields 1 expected)
    string(STRIP "${${prefix}_err}" line)
    if(NOT ${prefix}_code EQUAL 2 OR NOT "${line}" STREQUAL "nxaevora-engine: ${expected}"
       OR NOT "${${prefix}_out}" STREQUAL "")
        message(FATAL_ERROR "${prefix} ended with ${${prefix}_code}, said \"${line}\" on stderr and \"${${prefix}_out}\" on stdout")
    endif()
endforeach()
file(REMOVE_RECURSE "${dir}")
